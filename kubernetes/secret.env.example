# Copy to secret.env and fill in -- or let ./install.sh do it, which writes
# random values. secret.env is not committed (.gitignore).

# The password of the database in postgres.yaml. Used there and in
# DATABASE_URL below; both have to agree.
POSTGRES_PASSWORD=CHANGE-ME

# With postgres.yaml: leave the host as it is. With a database of your own:
# point this at it and remove postgres.yaml from kustomization.yaml.
DATABASE_URL=postgres://nexora:CHANGE-ME@postgres:5432/nexora?sslmode=disable

# Signs the sessions. Long and random: openssl rand -hex 32
JWT_SECRET=CHANGE-ME
