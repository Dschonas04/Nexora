# Nexora configuration — copy to .env and adjust

# Which compose files apply. Nexora itself is in docker-compose.yml; the
# database and the object store are side files, so that services already in
# place can be used instead. This line saves passing them with -f on every
# call.
#
#   Nexora only, outside database:  docker-compose.yml
#   with its own database:          docker-compose.yml:docker-compose.db.yml
#   plus a MinIO of its own:        …:docker-compose.minio.yml
#   plus a Redis:                   …:docker-compose.redis.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.db.yml

# Port the web UI is exposed on
PORT=3000

# The same service, encrypted. The container issues the certificate itself on
# the first start (825 days) and puts it into a volume so that it survives a
# rebuild. A real certificate goes into that volume under the same name, and
# then nothing is generated.
PORT_TLS=3443
# Stands in the certificate as its name; the IP goes in as an alternative name
# so the browser does not complain about the name on top of everything else.
NEXORA_TLS_NAME=nexora
NEXORA_TLS_IP=

# Verschlüsselt ist auch der Innenverkehr: Oberfläche, Dienst, Datenbank,
# Ablage und Zwischenspeicher sprechen untereinander über TLS, mit Zertifikaten
# aus einer kleinen eigenen Stelle, die der Container "pki" beim ersten
# Hochfahren anlegt. Dafür ist hier nichts einzutragen -- es läuft von selbst.
#
# Die beiden Werte braucht nur, wer den Dienst OHNE dieses Zertifikat betreibt,
# etwa mit einem eigenen Abbild ohne den pki-Container. Dann spricht die
# Oberfläche ihn wieder im Klartext an:
#
#   NEXORA_DIENST_SCHEMA=http
#   NEXORA_DIENST_PORT=8080

# Where the attachments lie. Empty means the volume nexora_files, so managed by
# Docker. A path in here mounts that directory instead: a disk of its own, a
# share, a mount of the NAS. The bytes then lie there and nowhere else, and a
# backup of that directory is a backup of the attachments.
#
#   NEXORA_ANHANG_ORT=/srv/nexora/anhaenge
#   NEXORA_ANHANG_ORT=/mnt/nas/nexora
#
# The directory has to belong to uid/gid 10001, otherwise the service may not
# write into it:  sudo chown -R 10001:10001 /srv/nexora/anhaenge
NEXORA_ANHANG_ORT=

# The path inside the container. Only worth changing when something else already
# occupies it; the place on the host is decided by NEXORA_ANHANG_ORT above.
NEXORA_ANHANG_PFAD=/data/attachments

# PostgreSQL password (used by db + backend)
POSTGRES_PASSWORD=change-me-please

# Only needed for an OUTSIDE database (then without docker-compose.db.yml).
# Otherwise leave it empty: the default points at the one shipped along.
# DATABASE_URL=postgres://user:secret@10.0.0.1:5432/nexora?sslmode=disable

# Secret used to sign session JWTs — use a long random string
# e.g. openssl rand -hex 32
JWT_SECRET=please-generate-a-long-random-secret

# License key for the paid extras (version history, attachments, sharing and
# public links). Leave empty: Nexora then runs with the free scope, and the
# locked calls answer with 402.
NEXORA_LIZENZ=

# Only for the side file docker-compose.minio.yml, the object store shipped
# along. A MinIO or S3 already in place is wired up through the NEXORA_S3_*
# values alone instead.
#
# Two separate accounts, on purpose: the root one administers the store, the
# second may only write into Nexora's bucket. Generate both secrets yourself,
# for instance with `openssl rand -hex 24`. Without them the stack will not
# start.
MINIO_ROOT_USER=verwalter
MINIO_ROOT_PASSWORD=
NEXORA_S3_ZUGRIFFSSCHLUESSEL=nexora-anwendung
NEXORA_S3_GEHEIMNIS=
NEXORA_S3_BUCKET=nexora

# Whether the local disk may stand in when the object store does not answer at
# startup. Empty means no: Nexora refuses to start instead, so that the
# attachments do not end up spread over a bucket and a directory. Set it to ja
# for the old behaviour.
NEXORA_S3_RUECKFALL=

# Where the ports are published. The default is this machine only; the store
# does not belong on the network. For access from outside set it to 0.0.0.0
# deliberately, and put TLS in front of it.
MINIO_ADRESSE=127.0.0.1
MINIO_PORT=9010
MINIO_KONSOLE_PORT=9011

# Kennzahlen für Prometheus. Leer heißt: den Weg /metrics gibt es nicht, er
# antwortet mit 404. Ein Losungswort setzen, und Prometheus kann ihn abholen —
# dasselbe Wort gehört dann in die scrape_config. Ein fertiges Grafana-Bild
# liegt unter grafana/nexora.json.
#
#   openssl rand -hex 24
#
# NEXORA_METRIKEN_TOKEN=
