# Nexora configuration — copy to .env and adjust

# Welche Compose-Dateien gelten. Nexora selbst steht in docker-compose.yml;
# Datenbank und Objektspeicher sind Beilagen, damit man auch vorhandene
# Dienste nehmen kann. Diese Zeile spart es, sie bei jedem Aufruf mit -f
# anzugeben.
#
#   nur Nexora, Datenbank fremd:  docker-compose.yml
#   mit eigener Datenbank:        docker-compose.yml:docker-compose.db.yml
#   dazu ein eigenes MinIO:       …:docker-compose.minio.yml
#   dazu ein Redis:               …:docker-compose.redis.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.db.yml

# Port the web UI is exposed on
PORT=3000

# Derselbe Dienst verschlüsselt. Das Zertifikat stellt der Container beim
# ersten Start selbst aus (825 Tage) und legt es in einen Datenträger, damit es
# einen Neubau überlebt. Ein echtes Zertifikat legt man unter demselben Namen
# in diesen Datenträger, dann wird nichts erzeugt.
PORT_TLS=3443
# Steht als Name im Zertifikat; die IP kommt als Alternativname hinein, damit
# der Browser nicht zusätzlich über den Namen klagt.
NEXORA_TLS_NAME=nexora
NEXORA_TLS_IP=

# PostgreSQL password (used by db + backend)
POSTGRES_PASSWORD=change-me-please

# Nur nötig, wenn eine FREMDE Datenbank genutzt wird (dann ohne
# docker-compose.db.yml). Sonst leer lassen, die Vorgabe zeigt auf die
# mitgelieferte.
# DATABASE_URL=postgres://nutzer:geheim@10.0.0.1:5432/nexora?sslmode=disable

# Secret used to sign session JWTs — use a long random string
# e.g. openssl rand -hex 32
JWT_SECRET=please-generate-a-long-random-secret

# Lizenzschlüssel für die kostenpflichtigen Zusätze (Versionsverlauf, Anhänge,
# Teilen und öffentliche Links). Leer lassen: Nexora läuft dann mit dem freien
# Umfang, die gesperrten Aufrufe antworten mit 402.
NEXORA_LIZENZ=

# Nur für die Beilage docker-compose.minio.yml: der mitgelieferte
# Objektspeicher. Ein vorhandenes MinIO oder S3 wird stattdessen allein über
# die NEXORA_S3_* Werte angebunden.
#
# Zwei getrennte Konten, mit Absicht: die Wurzel verwaltet den Speicher, das
# zweite Konto darf nur in den Eimer von Nexora schreiben. Beide Geheimnisse
# selbst erzeugen, etwa mit `openssl rand -hex 24`. Ohne sie startet der
# Verbund nicht.
MINIO_ROOT_USER=verwalter
MINIO_ROOT_PASSWORD=
NEXORA_S3_ZUGRIFFSSCHLUESSEL=nexora-anwendung
NEXORA_S3_GEHEIMNIS=
NEXORA_S3_BUCKET=nexora

# Wohin die Ports veröffentlicht werden. Vorgabe ist der eigene Rechner; der
# Speicher gehört nicht ins Netz. Für den Zugriff von außen ausdrücklich auf
# 0.0.0.0 setzen, und TLS davorstellen.
MINIO_ADRESSE=127.0.0.1
MINIO_PORT=9010
MINIO_KONSOLE_PORT=9011
