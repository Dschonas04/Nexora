# Copy to secret.env and fill in. secret.env is in .gitignore.
#
# The database has to exist already, with a user that owns it. The schema is
# created by the backend on its first start.
DATABASE_URL=postgres://nexora:CHANGE-ME@postgres.example.svc:5432/nexora?sslmode=disable
# Signs the sessions. openssl rand -hex 32
JWT_SECRET=CHANGE-ME
