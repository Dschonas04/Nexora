{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "title": "Nexora",
  "description": "Nexora aus der Sicht von Prometheus. Die Instanz selbst zeigt unter Einstellungen, System die letzte Minute; dieses Bild ist für die Frage, was heute Nacht um drei war.",
  "tags": [
    "nexora"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instanz",
        "label": "Instanz",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(nexora_seiten, instance)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Auf einen Blick",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Anfragen je Sekunde",
      "description": "Gemittelt über fünf Minuten.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(nexora_anfragen_total{instance=~\"$instanz\"}[5m]))",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Mittlere Antwortzeit",
      "description": "Aufsummierte Bearbeitungsdauer geteilt durch die Zahl der Anfragen. Ein Mittelwert, kein Quantil: die Instanz zählt Summen, keine Verteilung.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(nexora_anfragen_dauer_sekunden_summe{instance=~\"$instanz\"}[5m])) / sum(rate(nexora_anfragen_total{instance=~\"$instanz\"}[5m]))",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2ea043",
                "value": null
              },
              {
                "color": "#bf8700",
                "value": 0.3
              },
              {
                "color": "#cf222e",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Verbindungen belegt",
      "description": "Von der Obergrenze des Vorrats. Berührt der Wert die Grenze, wartet jede weitere Anfrage.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(nexora_vorrat_verbindungen{zustand=\"benutzt\",instance=~\"$instanz\"}) / sum(nexora_vorrat_verbindungen{zustand=\"hoechstens\",instance=~\"$instanz\"})",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2ea043",
                "value": null
              },
              {
                "color": "#bf8700",
                "value": 0.7
              },
              {
                "color": "#cf222e",
                "value": 0.95
              }
            ]
          },
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Seiten",
      "description": "Außerhalb des Papierkorbs.",
