    {
      "id": 20,
      "type": "timeseries",
      "title": "Anfragen je Sekunde, nach Ausgang",
      "description": "Abgewiesen sind 4xx, also jemand durfte nicht. Gescheitert sind 5xx, also etwas ist kaputt. Die beiden zu trennen ist der ganze Sinn dieses Bildes: eine Instanz, die fleißig 401 verteilt, tut genau das, was sie soll.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(nexora_anfragen_total{ergebnis=\"gut\",instance=~\"$instanz\"}[5m]))",
          "legendFormat": "gut",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(nexora_anfragen_total{ergebnis=\"abgelehnt\",instance=~\"$instanz\"}[5m]))",
          "legendFormat": "abgewiesen",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(nexora_anfragen_total{ergebnis=\"fehler\",instance=~\"$instanz\"}[5m]))",
          "legendFormat": "gescheitert",
          "range": true,
          "refId": "C"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisBorderShow": false,
            "gradientMode": "none",
            "pointSize": 8
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "gut"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2ea043"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "abgewiesen"
            },
            "properties": [
              {
                "id": "color",
